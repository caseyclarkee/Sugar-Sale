# Force correct MIME types for JS modules
/assets/*.js
  Content-Type: text/javascript; charset=utf-8
  
/*.js
  Content-Type: text/javascript; charset=utf-8

/src/*.jsx
  Content-Type: text/javascript; charset=utf-8
  
/*.jsx
  Content-Type: text/javascript; charset=utf-8

# Cache assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
